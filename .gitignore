# Saidas do Gradle. Ancorado de proposito: o padrao solto `build/` casa qualquer diretorio com
# esse nome em qualquer profundidade, inclusive o pacote buildSrc/src/main/kotlin/com/platos/build,
# e silenciosamente deixa codigo-fonte de fora do repositorio.
/build/
/buildSrc/build/
/apps/*/build/
/packages/*/build/
/out/
node_modules/
# Caminho do SDK Android: e da maquina, nao do projeto.
local.properties
.gradle/
.kotlin/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# Segredos e ambiente local
.env
.env.local
*.pem
*.key

# Supabase
supabase/.temp/
supabase/.branches/

# SO
.DS_Store
Thumbs.db

# Saidas de build do web e do comparador
apps/web/dist/
build/parity/
