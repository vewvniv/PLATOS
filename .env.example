# Copie para .env e preencha. Nunca versione o .env.

# Banco — a API conecta como app_backend, papel sem SUPERUSER e sem BYPASSRLS (D-0.2).
# Conectar como postgres faria toda politica RLS ser silenciosamente ignorada.
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
DATABASE_USER=app_backend
DATABASE_PASSWORD=

# Supabase Auth — validacao de JWT por JWKS (D-0.10).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
JWT_ISSUER=https://SEU-PROJETO.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json

# Entitlements versionados no Git (D-0.8).
PLANS_DIR=plans

PORT=8080
